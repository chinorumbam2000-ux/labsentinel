# LabSentinel API — PRODUCTION-LIKE (read-only) deployment.
#
# Every development-only endpoint answers 404 (FHIR ingestion demo,
# recalculations, evaluation reads, readiness), CORS allows GET only, and
# DEMO_ENDPOINTS_ENABLED=true is rejected at startup. The data served are
# still synthetic: this is a production-shaped capstone configuration, not a
# production public-health system (no authentication or RBAC yet).

APP_ENV=production
DEMO_ENDPOINTS_ENABLED=false

# SECRET. postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=
DATABASE_CONNECT_TIMEOUT=10
DATABASE_ECHO=false

# SECRET. A long random string of your own.
FHIR_PSEUDONYM_SALT=

CORS_ORIGINS=https://YOUR-FRONTEND-HOST
