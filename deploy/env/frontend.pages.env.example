# LabSentinel React app — PUBLIC GITHUB PAGES build (Local Demo Mode).
# The frozen classroom demonstration runs entirely in the browser: no backend,
# no SMART, no network requests for data. This is what .github/workflows
# deploy.yml builds from main.

VITE_DATA_SOURCE=local
VITE_SMART_ENABLED=false
# LABSENTINEL_BASE_PATH defaults to /labsentinel/
