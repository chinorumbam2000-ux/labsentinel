# LabSentinel API — PRIVATE CAPSTONE PRESENTATION / STAGING deployment.
#
# Set these as the hosting platform's environment variables (secrets marked
# SECRET). Never commit real values. Synthetic data only.
#
# With DEMO_ENDPOINTS_ENABLED=true the live demonstration works end to end
# (FHIR ingestion, recalculation, evaluation page, readiness). These endpoints
# are NOT production-secured (no authentication), so share the URL only with
# the presentation audience and turn them off (false) afterwards.

APP_ENV=presentation
DEMO_ENDPOINTS_ENABLED=true

# SECRET. The managed PostgreSQL connection string, psycopg 3 driver, TLS:
# postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=
DATABASE_CONNECT_TIMEOUT=10
DATABASE_ECHO=false

# SECRET. Required (and must not be the development default) when
# DEMO_ENDPOINTS_ENABLED=true. Any long random string.
FHIR_PSEUDONYM_SALT=
FHIR_MAX_REQUEST_BYTES=1000000

# The exact HTTPS origin of the deployed React app (no path, no trailing slash).
CORS_ORIGINS=https://YOUR-FRONTEND-HOST
