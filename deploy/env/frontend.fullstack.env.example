# LabSentinel React app — FULL-STACK build (API Capstone Mode).
#
# Every VITE_* value is compiled into the JavaScript the browser downloads, so
# NOTHING here may be secret: no client secret, token, password or salt.
# Set these as build-time environment variables on the static host.

VITE_DATA_SOURCE=api

# The deployed API's HTTPS origin (no trailing slash).
VITE_API_BASE_URL=https://YOUR-API-HOST

# Where the app is served. "/" at a domain root; the default "/labsentinel/"
# matches GitHub Pages. Read by vite.config.ts at build time (not a VITE_ value).
LABSENTINEL_BASE_PATH=/

# SMART on FHIR sandbox (public client, PKCE, no secret). Optional.
VITE_SMART_ENABLED=true
VITE_SMART_CLIENT_ID=labsentinel-capstone-sandbox
VITE_SMART_SCOPES=openid fhirUser patient/Observation.rs
# Must be the deployed https callback: <frontend origin><base path>smart/callback
VITE_SMART_REDIRECT_URI=https://YOUR-FRONTEND-HOST/smart/callback
