# LabSentinel API — DEVELOPMENT (your own machine).
# Copy to backend/.env. Throwaway local values; nothing here is a real credential.
# Every development-only endpoint is available: FHIR ingestion demo,
# recalculations, evaluation reads and the readiness checklist.

APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000

# docker compose up -d db (loopback only)
DATABASE_URL=postgresql+psycopg://labsentinel:labsentinel@127.0.0.1:5432/labsentinel
DATABASE_CONNECT_TIMEOUT=5
DATABASE_ECHO=false

FHIR_PSEUDONYM_SALT=labsentinel-development-only-salt
FHIR_MAX_REQUEST_BYTES=5000000

# Defaults cover the Vite dev (5173) and preview (4173) servers.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
