# LabSentinel API — example environment.
#
# Copy to backend/.env and adjust. backend/.env is git-ignored; never commit it.
# These values are throwaway local-development defaults, not real credentials.

APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000

# Must use the psycopg 3 driver (postgresql+psycopg://).
# Matches the development PostgreSQL service in ../docker-compose.yml.
# Use 127.0.0.1, not localhost: the container is published on IPv4 loopback
# only, and "localhost" tries IPv6 ::1 first, stalling every new connection
# for the full DATABASE_CONNECT_TIMEOUT.
DATABASE_URL=postgresql+psycopg://labsentinel:labsentinel@127.0.0.1:5432/labsentinel

# Seconds to wait for PostgreSQL before a connection attempt fails.
DATABASE_CONNECT_TIMEOUT=5

# Log every SQL statement (development debugging only).
DATABASE_ECHO=false

# Comma-separated browser origins allowed to call the API. Wildcards are
# rejected. Defaults to the Vite dev (5173) and preview (4173) servers.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
