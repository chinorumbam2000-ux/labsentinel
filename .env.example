# LabSentinel frontend — example environment.
#
# Copy to .env.local to change how `npm run dev` / `npm run build` read data.
# .env and .env.* are git-ignored (except this file). Nothing here is secret.

# Where the app reads its data:
#   local  the prototype's synthetic data, computed in the browser (default;
#          used by the GitHub Pages build, needs no backend)
#   api    the LabSentinel FastAPI backend and PostgreSQL (see backend/README.md)
# Any other value stops the app with a configuration error.
VITE_DATA_SOURCE=local

# FastAPI base URL, used only when VITE_DATA_SOURCE=api.
VITE_API_BASE_URL=http://127.0.0.1:8000

# SMART on FHIR sandbox launch (Phase 6). Off by default: with it off, the app
# makes no SMART discovery or sandbox requests and shows no SMART controls.
# LabSentinel is a *public* browser client (PKCE, no client secret). Never put
# a client secret, token or production credential in any VITE_* variable:
# every VITE_* value is compiled into the JavaScript the browser downloads.
VITE_SMART_ENABLED=false

# Client id registered with (or accepted by) the SMART sandbox. The SMART
# Health IT sandbox accepts any id for a public client.
VITE_SMART_CLIENT_ID=labsentinel-capstone-sandbox

# Least-privilege read/search scopes. The launch-context scope (launch or
# launch/patient) is added per launch type; write scopes, wildcards and
# offline_access are rejected at startup.
VITE_SMART_SCOPES=openid fhirUser patient/Observation.rs

# Optional. Defaults to <origin><base>smart/callback, e.g.
# http://localhost:5173/labsentinel/smart/callback. Must be https, or http on
# localhost / 127.0.0.1.
# VITE_SMART_REDIRECT_URI=http://localhost:5173/labsentinel/smart/callback

# Optional. FHIR server for the standalone launch; defaults to the SMART
# Health IT R4 sandbox.
# VITE_SMART_STANDALONE_ISS=https://launch.smarthealthit.org/v/r4/fhir
