# LabSentinel frontend — example environment.
#
# Copy to .env.local to change how `npm run dev` / `npm run build` read data.
# .env and .env.* are git-ignored (except this file). Nothing here is secret.

# Where the app reads its data:
#   local  the prototype's synthetic data, computed in the browser (default;
#          used by the GitHub Pages build, needs no backend)
#   api    the LabSentinel FastAPI backend and PostgreSQL (see backend/README.md)
# Any other value stops the app with a configuration error.
VITE_DATA_SOURCE=local

# FastAPI base URL, used only when VITE_DATA_SOURCE=api.
VITE_API_BASE_URL=http://127.0.0.1:8000
